<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_backfill_public_holiday_timesheets" model="ir.cron">
        <field name="name">Timesheets: add missing public holiday entries</field>
        <field name="model_id" ref="resource.model_resource_calendar_leaves"/>
        <field name="state">code</field>
        <field name="code">model._cron_backfill_public_holiday_timesheets()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
    </record>
</odoo>
